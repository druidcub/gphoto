{
  "name": "gphoto-frame",
  "version": "0.3.3",
  "description": "A lightweight Tauri photo frame for Windows displays",
  "author": "GPhoto Frame contributors",
  "license": "MIT",
  "scripts": {
    "release:check": "node scripts/release.cjs check",
    "release:prepare": "node scripts/release.cjs prepare",
    "release:draft": "node scripts/release.cjs draft",
    "test:release": "node --test scripts/release-checks.cjs",
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "npm run typecheck && tauri build",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-test-renderer": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
